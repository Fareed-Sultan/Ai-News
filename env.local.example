
# Get a free key at https://newsapi.org/register
NEWS_API_KEY=your_news_api_key_here

# Optional: enables AI curation of the news feed (filters out stale/off-topic
# syndicated articles, prioritizes genuinely relevant results). Get a key at
# https://console.anthropic.com. If left unset, the app still works — it
# just skips this extra curation step.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Required for the chatbot (bottom-left icon) to answer questions.
# Get a free key at https://aistudio.google.com/apikey — uses model gemini-3.6-flash.
GEMINI_API_KEY=your_gemini_api_key_here

# Required for the chatbot to show real YouTube videos alongside its answers.
# Get a free key (enable "YouTube Data API v3") at https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_api_key_here